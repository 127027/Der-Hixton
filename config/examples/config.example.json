{
  "schema_version": 1,
  "strategy": {
    "version": "HIXTON-SPEC-1.0",
    "timeframe": "1h",
    "source": "close",
    "vidya_length": 10,
    "momentum_length": 20,
    "smoothing_length": 15,
    "atr_length": 200,
    "band_multiplier": 2.0,
    "warmup_bars": 400,
    "long_only": true,
    "compounding": false
  },
  "markets": [
    "BTCUSDT",
    "ETHUSDT",
    "BNBUSDT",
    "SOLUSDT",
    "XRPUSDT",
    "ADAUSDT",
    "LINKUSDT",
    "AVAXUSDT",
    "DOTUSDT",
    "DOGEUSDT"
  ],
  "backtest": {
    "starting_usdt_per_symbol": "250.00",
    "target_notional_usdt": "250.00",
    "primary_window_years": 3,
    "run_baseline_and_stress": true
  },
  "paper": {
    "starting_cash_usdt": "240.00",
    "slot_count": 3,
    "target_notional_usdt": "80.00",
    "poll_seconds": 30,
    "daily_audit_utc": "00:05"
  },
  "ui": {
    "bind": "127.0.0.1",
    "port": 8765,
    "timezone": "Europe/Berlin",
    "default_range": "1m"
  },
  "runtime": {
    "database_path": "data/hixton.sqlite3",
    "run_output_root": "backtests/v1/runs",
    "binance_base_url": "https://api.binance.com"
  }
}
